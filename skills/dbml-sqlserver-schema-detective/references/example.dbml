Project IndustrialAcquisition {
  database_type: 'SQLServer'
  Note: 'Historical PLC signal acquisition with first-party email/password authentication and secure API management. Modules: Identity & Access, API Management, Signal Acquisition.'
}

// Conventions: UpperCamelCase, singular, English names; Id = primary key; Id-prefixed foreign keys.
// Timestamps end with At (datetime2, UTC); calendar dates end with Date (date).
// Every table carries CreatedAt, ModifiedAt, RecordStatus, IdCreatedBy, IdModifiedBy.
// RecordStatus (tinyint = byte in .NET): 0 = inactive, 1 = active.


// ============================================================
// [MODULE:01] IDENTITY & ACCESS
// Scope : Accounts authenticated with their own email and password.
// Tables: UserType, User
// ============================================================

// ---- [01.1] Catalogs ----

Table UserType {
  Note: 'Lookup of account types (e.g. Administrator, Operator, Viewer). Avoids free text in User.'

  Id int [pk, increment, note: 'Surrogate primary key generated by the database.']

  Description nvarchar(100) [not null, unique, note: 'Display name of the user type; unique.']

  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the record was created.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = active, 0 = inactive.']

  IdCreatedBy int [not null, note: 'User who created the record.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
}

// ---- [01.2] Entities ----

Table User {
  Note: 'Accounts authenticated with email and password. Base entity for authentication and for the audit columns of every table.'

  Id int [pk, increment, note: 'Surrogate primary key generated by the database.']

  Name nvarchar(150) [not null, note: 'Display name of the account. Naming exception: persons/users use Name instead of Description.']
  Email nvarchar(254) [not null, unique, note: 'Unique login email; normalize case consistently.']
  PasswordHash varchar(255) [not null, note: 'Hash produced by a modern algorithm such as Argon2id; never store plaintext.']
  EmailVerified bit [not null, default: 0, note: 'Whether ownership of the email address has been verified.']

  EmailVerifiedAt datetime2 [note: 'UTC timestamp of email verification; null until it succeeds.']
  LastLoginAt datetime2 [note: 'UTC timestamp of the latest successful login.']
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the record was created.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = active, 0 = inactive.']

  IdCreatedBy int [not null, note: 'User who created the record. The root account is created by a controlled seed that references itself.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
  IdUserType int [not null, note: 'FK to UserType. Account type.']
}

// ---- [01.R] Relationships ----
Ref: User.IdUserType > UserType.Id
Ref: User.IdCreatedBy > User.Id
Ref: User.IdModifiedBy > User.Id
Ref: UserType.IdCreatedBy > User.Id
Ref: UserType.IdModifiedBy > User.Id

TableGroup IdentityAccess {
  UserType
  User
  Note: 'Module 01 - Identity & Access'
}


// ============================================================
// [MODULE:02] API MANAGEMENT
// Scope : Credentials that external clients use to call the API.
// Tables: ApiKey
// ============================================================

// ---- [02.1] Entities ----

Table ApiKey {
  Note: 'API credentials issued to a user. Only a hash of the key is stored.'

  Id int [pk, increment, note: 'Surrogate primary key generated by the database.']

  Description nvarchar(150) [not null, note: 'Purpose or consumer of the key (e.g. "SCADA gateway").']
  KeyHash varchar(255) [not null, unique, note: 'Hash of the secret; the plain key is shown once at creation and never stored.']

  ExpiresAt datetime2 [note: 'UTC expiration timestamp; null means it does not expire.']
  LastUsedAt datetime2 [note: 'UTC timestamp of the latest successful call.']
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the record was created.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = active, 0 = inactive (revoked).']

  IdCreatedBy int [not null, note: 'User who created the record.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
  IdUser int [not null, note: 'FK to User. Owner of the key.']
}

// ---- [02.R] Relationships ----
Ref: ApiKey.IdUser > User.Id          // -> [MODULE:01]
Ref: ApiKey.IdCreatedBy > User.Id     // -> [MODULE:01]
Ref: ApiKey.IdModifiedBy > User.Id    // -> [MODULE:01]

TableGroup ApiManagement {
  ApiKey
  Note: 'Module 02 - API Management'
}


// ============================================================
// [MODULE:03] SIGNAL ACQUISITION
// Scope : Catalog of PLC signals and their historical readings.
// Tables: SignalType, Signal, SignalReading
// ============================================================

// ---- [03.1] Catalogs ----

Table SignalType {
  Note: 'Lookup of signal kinds (e.g. Temperature, Pressure, Speed, Digital Input).'

  Id int [pk, increment, note: 'Surrogate primary key generated by the database.']

  Description nvarchar(100) [not null, unique, note: 'Display name of the signal type; unique.']

  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the record was created.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = active, 0 = inactive.']

  IdCreatedBy int [not null, note: 'User who created the record.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
}

// ---- [03.2] Entities ----

Table Signal {
  Note: 'Definition of a signal read from the PLC (one row per tag).'

  Id int [pk, increment, note: 'Surrogate primary key generated by the database.']

  Description nvarchar(250) [not null, note: 'Human-readable description of the signal.']
  Tag varchar(100) [not null, unique, note: 'Technical tag/address in the PLC; unique.']

  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the record was created.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = active, 0 = inactive.']

  IdCreatedBy int [not null, note: 'User who created the record.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
  IdSignalType int [not null, note: 'FK to SignalType. Kind of signal.']
}

Table SignalReading {
  Note: 'High-volume historical readings. Uses bigint Id; consider partitioning by ReadAt.'

  Id bigint [pk, increment, note: 'Surrogate primary key generated by the database.']

  Value decimal(18,4) [not null, note: 'Measured value in the signal engineering unit.']

  ReadAt datetime2 [not null, note: 'UTC timestamp when the PLC sampled the value.']
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp when the row was inserted.']
  ModifiedAt datetime2 [not null, default: `SYSUTCDATETIME()`, note: 'UTC timestamp of the latest update; refresh on every modification.']

  RecordStatus tinyint [not null, default: 1, note: 'Lifecycle state: 1 = valid, 0 = discarded.']

  IdCreatedBy int [not null, note: 'User or service account that inserted the row.']
  IdModifiedBy int [not null, note: 'User responsible for the latest modification; equals IdCreatedBy at creation.']
  IdSignal int [not null, note: 'FK to Signal. Signal that produced the reading.']

  indexes {
    (IdSignal, ReadAt) [note: 'Supports time-range queries per signal.']
  }
}

// ---- [03.R] Relationships ----
Ref: SignalType.IdCreatedBy > User.Id       // -> [MODULE:01]
Ref: SignalType.IdModifiedBy > User.Id      // -> [MODULE:01]
Ref: Signal.IdSignalType > SignalType.Id
Ref: Signal.IdCreatedBy > User.Id           // -> [MODULE:01]
Ref: Signal.IdModifiedBy > User.Id          // -> [MODULE:01]
Ref: SignalReading.IdSignal > Signal.Id
Ref: SignalReading.IdCreatedBy > User.Id    // -> [MODULE:01]
Ref: SignalReading.IdModifiedBy > User.Id   // -> [MODULE:01]

TableGroup SignalAcquisition {
  SignalType
  Signal
  SignalReading
  Note: 'Module 03 - Signal Acquisition'
}
